{
  "info": {
    "name": "Farmacia API REST",
    "description": "Coleccion de pruebas para la API REST de Farmacia (medicamentos y clientes). Autenticacion Basic sobre /api/**.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "username",
      "value": "admin",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "medicamentoId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "clienteId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Medicamentos - Listar",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/medicamentos",
          "host": ["{{baseUrl}}"],
          "path": ["api", "medicamentos"]
        }
      },
      "response": []
    },
    {
      "name": "Medicamentos - Buscar por id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/medicamentos/{{medicamentoId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "medicamentos", "{{medicamentoId}}"]
        }
      },
      "response": []
    },
    {
      "name": "Medicamentos - Guardar",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Paracetamol 500mg\",\n  \"precio\": 1500.0,\n  \"stock\": 100\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/medicamentos",
          "host": ["{{baseUrl}}"],
          "path": ["api", "medicamentos"]
        }
      },
      "response": []
    },
    {
      "name": "Medicamentos - Actualizar",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Paracetamol 500mg\",\n  \"precio\": 1700.0,\n  \"stock\": 80\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/medicamentos/{{medicamentoId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "medicamentos", "{{medicamentoId}}"]
        }
      },
      "response": []
    },
    {
      "name": "Medicamentos - Eliminar",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/medicamentos/{{medicamentoId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "medicamentos", "{{medicamentoId}}"]
        }
      },
      "response": []
    },
    {
      "name": "Clientes - Listar",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/clientes",
          "host": ["{{baseUrl}}"],
          "path": ["api", "clientes"]
        }
      },
      "response": []
    },
    {
      "name": "Clientes - Buscar por id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/clientes/{{clienteId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "clientes", "{{clienteId}}"]
        }
      },
      "response": []
    }
  ]
}
